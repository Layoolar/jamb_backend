# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres. Local dev assumes the natively installed Postgres 18.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sabipass

# Signing key for our own access/refresh JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google OAuth. Three client IDs exist (iOS / Android / Web); all of them are
# valid audiences for an ID token, so list every one you created, comma-separated.
GOOGLE_CLIENT_IDS=

# Apple Sign-In. Native iOS flow only, so this is just the bundle ID —
# no Services ID, no .p8 private key, no client secret needed.
APPLE_BUNDLE_ID=com.sabipass.app

# Question generation (scripts/generate.ts). Not needed to run the server.
ANTHROPIC_API_KEY=
